# Host directory that contains the SHARE_PREFIX subtree (deployment-specific).
HOST_SHARE_PATH=
# SFTP-visible logical path prefix; also the first segment of every hash input.
SHARE_PREFIX=files
# External base URL used to render share links (TLS terminates at the proxy).
PUBLIC_URL=
# file = hash file contents; filename = hash the basename.
HASH_TARGET=file
# md5 (default, short URLs) or sha256.
HASH_ALGORITHM=md5
# Bearer token for the share-link management API (/api/links).
# Required: the file-sharing container fails fast when empty.
ADMIN_TOKEN=
# Directory holding links.json, on the file-links named volume.
LINKS_DIR=/var/lib/file-links
# Host-side published port.
PORT=8080
# Image tag used by Compose; latest is convenient for development, while
# production deployments should override it with an immutable vX.Y.Z tag.
IMAGE_TAG=latest

# SFTP Host-side SSH port; the container always listens on 22.
SFTP_PORT=2222
# Numeric group ID used by SFTP users for the writable SHARE_PREFIX subtree.
# The Host directory's SHARE_PREFIX subtree must use this group ID.
SFTP_GID=2000
# Numeric group ID for the web readers group. Per-user directories are created
# with this group so the web service can read files while SFTP users cannot
# access other users' directories. Must differ from SFTP_GID.
WEB_GID=2001
# Admin UI is remote-accessible (0.0.0.0) by default. Before using it beyond
# a trusted host, require a TLS reverse proxy or private network/VPN and a
# host firewall rule limiting access to trusted administrator IPs.
SFTP_ADMIN_PORT=8081
SFTP_ADMIN_PASSWORD=
# Optional first SFTP user. Both values must be set together and are honored
# only when sftp-users/users.json does not exist.
SFTP_SEED_USER=
SFTP_SEED_PUBKEY=
