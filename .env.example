# Host directory that contains the SHARE_PREFIX subtree (deployment-specific).
HOST_SHARE_PATH=/path/to/sftp-root
# SFTP-visible logical path prefix; also the first segment of every hash input.
SHARE_PREFIX=files
# External base URL used to render share links (TLS terminates at the proxy).
PUBLIC_URL=https://weurl.everplast.net
# file = hash file contents; filename = hash the basename.
HASH_TARGET=file
# md5 (default, short URLs) or sha256.
HASH_ALGORITHM=md5
# Secret single-segment path where the file listing is served
# (e.g. https://weurl.everplast.net/admin123456).
# Empty disables the listing entirely; "/" always returns 200
# with an empty body.
ADMIN_PATH=admin123456
# Optional extra gate: when set, the admin path requires this password
# (submitted via the password form) before showing files.
# Empty means the secret path alone is sufficient.
ADMIN_PASSWORD=
# Host-side published port.
PORT=8080

# SFTP Host-side SSH port; the container always listens on 22.
SFTP_PORT=2222
# Numeric group ID used by SFTP users for the writable SHARE_PREFIX subtree.
# The Host directory's SHARE_PREFIX subtree must use this group ID.
SFTP_GID=2000
# Admin UI is published on localhost by default; place behind TLS/private
# network before exposing it beyond the deployment host.
SFTP_ADMIN_PORT=8081
SFTP_ADMIN_PASSWORD=change-this-admin-password
# Optional first SFTP user. Both values must be set together and are honored
# only when sftp-users/users.json does not exist.
SFTP_SEED_USER=
SFTP_SEED_PUBKEY=
